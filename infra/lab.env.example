# Copy to infra/lab.env (gitignored) and edit. Sourced by the scripts in infra/.

# LAN IP of the machine that runs Open OSCAR Server. XP/Vista clients must reach it.
SERVER_IP=192.168.0.248
# LAN IP of the machine that runs dnsmasq (often the same machine).
GATEWAY_IP=192.168.0.248
# Network interface facing the LAN (used by dnsmasq and tcpdump). macOS: en0. Linux: eth0 etc.
LAN_IFACE=en0
# Upstream DNS for everything that is not redirected or stubbed.
UPSTREAM_DNS=1.1.1.1

# Open OSCAR Server release to install.
OSCAR_VERSION=0.24.0
# Management API (bound to localhost only by default).
API_URL=http://127.0.0.1:8080
# false = accounts must exist (created via the Management API). true = any login works.
DISABLE_AUTH=false
