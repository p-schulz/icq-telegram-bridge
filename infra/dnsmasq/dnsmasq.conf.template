# Generated into infra/dnsmasq/generated/dnsmasq.conf by run-dnsmasq.sh.
# @VAR@ placeholders are filled from infra/lab.env.

# DNS only. No DHCP: the XP/Vista clients get this server's IP as their DNS
# server manually (see docs/setup-guide.md).
port=53
interface=@LAN_IFACE@
bind-interfaces
no-resolv
server=@UPSTREAM_DNS@
domain-needed
bogus-priv

# Log every query. This is the M0 hostname inventory (docs/findings.md).
log-queries
log-facility=@LOG_FILE@

# Redirects and stubs. Edit redirects.conf as findings come in.
conf-file=@REDIRECTS_FILE@
